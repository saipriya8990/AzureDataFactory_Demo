{
	"name": "PL_Email_Multitable",
	"properties": {
		"activities": [
			{
				"name": "Send_Email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Prepare_Email_details",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().parameters.Email_URL",
						"type": "Expression"
					},
					"body": {
						"value": "@variables('Full_Email_Details')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare_Email_details",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set_Email_subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set_Email_Body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Full_Email_Details",
					"value": {
						"value": "{\"email_recepient\":\"@{pipeline().parameters.email_recepient}\",\n\"subject\":\"@{variables('Email_Subject')}\",\n\"body\":\"@{variables('Email_Body')}\"\n}\n\n",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_Email_subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Email_Subject",
					"value": {
						"value": "Ingestion Completed",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set_Email_Body",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Email_Body",
					"value": {
						"value": "Ingestion has been completed and below is the list of tables status: \n@{replace(string(pipeline().parameters.table_status),'\"','')}\n\nPipeline Run ID: @{pipeline().RunId}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"Email_URL": {
				"type": "string",
				"defaultValue": "https://<logic app URL>"
			},
			"email_recepient": {
				"type": "string",
				"defaultValue": "saipriya8990@gmail.com"
			},
			"table_status": {
				"type": "array"
			}
		},
		"variables": {
			"Email_Subject": {
				"type": "String"
			},
			"Email_Body": {
				"type": "String"
			},
			"Full_Email_Details": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-06T17:39:13Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}
