{
	"name": "PL_Ingestion",
	"properties": {
		"activities": [
			{
				"name": "Execute_Send_Success_Email",
				"type": "ExecutePipeline",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Check_Source_Count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Email_Singletable",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"Email_URL": {
							"value": "@pipeline().parameters.Email_URL",
							"type": "Expression"
						},
						"table_name": {
							"value": "@pipeline().parameters.table_name",
							"type": "Expression"
						},
						"status": "SUCCESS",
						"email_recepient": {
							"value": "@pipeline().globalParameters.Email_Recepient",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Execute_Send_Failure_Email",
				"type": "ExecutePipeline",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Check_Source_Count",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Email_Singletable",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"Email_URL": {
							"value": "@pipeline().parameters.Email_URL",
							"type": "Expression"
						},
						"table_name": {
							"value": "@pipeline().parameters.table_name",
							"type": "Expression"
						},
						"status": "FAILED",
						"email_recepient": {
							"value": "@pipeline().globalParameters.Email_Recepient",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Read_Metadata_Table",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select watermark_value from metadata.table_watermarks where table_name = '@{toLower(pipeline().parameters.table_name)}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_Server",
						"type": "DatasetReference",
						"parameters": {
							"schema": "dbo",
							"table_name": "customers"
						}
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Get_Count_Of_Records",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Read_Metadata_Table",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select count(*) as countt from @{pipeline().parameters.schema}.@{pipeline().parameters.table_name} where ModifiedDate > '@{activity('Read_Metadata_Table').output.firstRow.watermark_value}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SQL_Server",
						"type": "DatasetReference",
						"parameters": {
							"schema": "dbo",
							"table_name": "customers"
						}
					}
				}
			},
			{
				"name": "Check_Source_Count",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Get_Count_Of_Records",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(activity('Get_Count_Of_Records').output.firstRow.countt,0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Ingest_SQL_SB_Data",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "select * from @{pipeline().parameters.schema}.@{pipeline().parameters.table_name} where ModifiedDate > '@{activity('Read_Metadata_Table').output.firstRow.watermark_value}'",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_SQL_Server",
									"type": "DatasetReference",
									"parameters": {
										"schema": {
											"value": "@pipeline().parameters.schema",
											"type": "Expression"
										},
										"table_name": {
											"value": "@pipeline().parameters.table_name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_CSV_Demo",
									"type": "DatasetReference",
									"parameters": {
										"table_name": {
											"value": "@pipeline().parameters.table_name",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Update_Watermark_Value",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Ingest_SQL_SB_Data",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_SQL_Server",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "update metadata.table_watermarks \nset watermark_value = SYSUTCDATETIME()\nwhere table_name = '@{pipeline().parameters.table_name}'",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			},
			{
				"name": "Fail_pipeline_if_anyone_Activity_fails",
				"description": "Fail activity gets triggered when any of the activities inside if condition fails.",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Check_Source_Count",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": "The Pipeline has failed. Please check the failed activity.",
					"errorCode": "500"
				}
			}
		],
		"parameters": {
			"schema": {
				"type": "string",
				"defaultValue": "dbo"
			},
			"table_name": {
				"type": "string",
				"defaultValue": "customers"
			},
			"Email_URL": {
				"type": "string",
				"defaultValue": "https://<logic app URL>"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-06T17:48:26Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}
